{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "realm": {
      "type": "string",
      "minLength": 1
    },
    "currency_unit": {
      "enum": [
        "旧积分",
        "新积分"
      ]
    },
    "converted": {
      "type": "boolean"
    },
    "balance": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d{1,3})?$"
    },
    "total_income": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d{1,3})?$"
    },
    "total_expense": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d{1,3})?$"
    },
    "owned": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      }
    },
    "equipped": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "slots": {
      "type": "integer",
      "minimum": 3,
      "maximum": 6
    },
    "claimed_milestones": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "claimed_rewards": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "pending_offer": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "minLength": 1
            },
            "pool": {
              "enum": [
                "metal",
                "wood",
                "water",
                "fire",
                "earth",
                "wind",
                "lightning",
                "light",
                "space",
                "time",
                "blade",
                "sword",
                "spear",
                "staff",
                "axe",
                "unarmed",
                "movement",
                "controller",
                "illusion",
                "soul",
                "beast",
                "body",
                "gene",
                "special",
                "training",
                "will"
              ]
            },
            "choices": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true
            },
            "catalog_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "candidate_count": {
              "type": "integer",
              "minimum": 1
            },
            "price_base_points": {
              "type": "integer",
              "minimum": 0
            },
            "reward_token": {
              "type": [
                "string",
                "null"
              ]
            },
            "owned_levels_at_offer": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              }
            }
          },
          "required": [
            "id",
            "at",
            "pool",
            "choices",
            "catalog_hash",
            "candidate_count",
            "price_base_points",
            "reward_token",
            "owned_levels_at_offer"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": [
              "string",
              "object"
            ]
          },
          "delta_base_points": {
            "type": "integer"
          },
          "amount": {
            "type": "string"
          },
          "unit": {
            "enum": [
              "旧积分",
              "新积分"
            ]
          }
        },
        "required": [
          "at",
          "kind",
          "detail",
          "delta_base_points",
          "amount",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "draw_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "minLength": 1
          },
          "pool": {
            "enum": [
              "metal",
              "wood",
              "water",
              "fire",
              "earth",
              "wind",
              "lightning",
              "light",
              "space",
              "time",
              "blade",
              "sword",
              "spear",
              "staff",
              "axe",
              "unarmed",
              "movement",
              "controller",
              "illusion",
              "soul",
              "beast",
              "body",
              "gene",
              "special",
              "training",
              "will"
            ]
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true
          },
          "catalog_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "candidate_count": {
            "type": "integer",
            "minimum": 1
          },
          "price_base_points": {
            "type": "integer",
            "minimum": 0
          },
          "reward_token": {
            "type": [
              "string",
              "null"
            ]
          },
          "owned_levels_at_offer": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            }
          },
          "selected": {
            "type": "string",
            "minLength": 1
          },
          "from_level": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "to_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "resolved_at": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "at",
          "pool",
          "choices",
          "catalog_hash",
          "candidate_count",
          "price_base_points",
          "reward_token",
          "owned_levels_at_offer",
          "selected",
          "from_level",
          "to_level",
          "resolved_at"
        ],
        "additionalProperties": false
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "name",
    "realm",
    "currency_unit",
    "converted",
    "balance",
    "total_income",
    "total_expense",
    "owned",
    "equipped",
    "slots",
    "claimed_milestones",
    "claimed_rewards",
    "pending_offer",
    "ledger",
    "draw_history",
    "revision"
  ],
  "additionalProperties": false
}
